+            up_result.stdout + up_result.stderr,
+            encoding="utf-8",
+        )
+        redis_id = _compose(project, override, "ps", "--quiet", "redis").stdout.strip()
+        traefik_id = _compose(
+            project, override, "ps", "--quiet", "traefik"
