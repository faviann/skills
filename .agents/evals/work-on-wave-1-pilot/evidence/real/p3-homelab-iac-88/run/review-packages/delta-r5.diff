+                f"      - {certificates_directory}:/var/traefik/certs:rw",
+                f"      - {logs_directory}:/logs:rw",
+                "  redis:",
+                "    container_name: !reset null",
+                '    restart: "no"',
+                "    ports: !reset []",
+                "networks:",
+                "  shared:",
+                "    external: false",
+                "",
+            ]
+        ),
+        encoding="utf-8",
+    )
+    override.chmod(0o600)
