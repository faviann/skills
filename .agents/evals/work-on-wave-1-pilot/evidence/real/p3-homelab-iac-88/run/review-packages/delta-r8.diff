+def _compose(
+    project: str,
+    overrides: tuple[Path, ...],
+    *args: str,
+    check: bool = True,
+) -> subprocess.CompletedProcess[str]:
+    command = [
+        "docker",
+        "compose",
+        "--project-name",
+        project,
+        "--file",
+        str(COMPOSE_PATH),
+    ]
+    for override in overrides:
+        command.extend(("--file", str(override)))
+    command.extend(args)
+    result = subprocess.run(
+        command,
+        check=False,
+        capture_output=True,
+        text=True,
+        timeout=120,
+        env={
+            **os.environ,
+            "CF_DNS_API_TOKEN": "<REPLACE_ME>",
+            "TRAEFIK_DASHBOARD_CREDENTIALS": "<REPLACE_ME>",
+        },
+    )
