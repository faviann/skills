      },
      "networks": {
        "shared": null
      },
      "security_opt": [
        "no-new-privileges:true"
      ]
    },
    "redis": {
      "command": null,
      "entrypoint": null,
      "environment": {
        "ALLOW_EMPTY_PASSWORD": "yes"
      },
      "image": "bitnami/redis:latest",
      "networks": {
        "shared": null
      },
      "restart": "no"
    },
    "traefik": {
      "command": null,
      "depends_on": {
        "traefik-docker-socket-proxy": {
          "condition": "service_started",
          "required": true
