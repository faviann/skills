      "driver": "bridge",
      "ipam": {}
    }
  },
  "services": {
    "backend": {
      "command": [
        "--entrypoints.backend.address=:8081",
        "--ping=true",
        "--ping.entrypoint=backend"
      ],
      "entrypoint": null,
      "image": "docker.io/library/traefik:v3.6",
      "labels": {
        "traefik.enable": "true",
        "traefik.http.routers.portal-entry.rule": "Host(`portal-entry.local.faviann.com`)",
